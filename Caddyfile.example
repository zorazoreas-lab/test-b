# Selepas domain DNS diarahkan ke IP VPS, ganti contoh.com dan HASH_PASSWORD.
# Hash kata laluan: caddy hash-password --plaintext 'PASSWORD_KUKUH_ANDA'
searchboost.contoh.com {
    basic_auth {
        admin HASH_PASSWORD
    }
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy 127.0.0.1:8080
}
